{
  "$schema": "https://raw.githubusercontent.com/madbrolab/dian115/main/docs/plugin-platform/manifest.schema.json",
  "schema_version": 1,
  "id": "xiaobai.wecom-notify",
  "name": "企业微信通知",
  "version": "0.1.0",
  "description": "企业微信应用消息通知，支持 Emby 电影和剧集入库、持久化队列和失败诊断。",
  "default_locale": "zh-CN",
  "publisher": {
    "name": "小白 · 本地开发",
    "key_id": "ed25519:REPLACED_BY_PACKAGER"
  },
  "compatibility": {
    "dian115": ">=4.0.64 <4.0.65",
    "plugin_api": "^2.0"
  },
  "runtime": {
    "kind": "wasm",
    "entry": "runtime/plugin.wasm",
    "protocol": "dian115:wasm@1",
    "startup_timeout_ms": 10000,
    "shutdown_timeout_ms": 5000,
    "timeout_ms": 60000,
    "background_timeout_ms": 300000,
    "max_concurrency": 1,
    "restart_policy": "on-failure",
    "memory_mb": 128,
    "resident": true
  },
  "permissions": {
    "apis": [
      {
        "method": "GET",
        "path": "/api/plugin-runtime/storage/:key",
        "reason": "读取插件配置、游标、发送队列与日志"
      },
      {
        "method": "PUT",
        "path": "/api/plugin-runtime/storage/:key",
        "reason": "持久化配置、增量游标与发送状态"
      },
      {
        "method": "GET",
        "path": "/api/plugin-host/emby/instances",
        "reason": "选择用户已配置的 Emby 实例",
        "optional": true
      },
      {
        "method": "GET",
        "path": "/api/plugin-host/emby/libraries",
        "reason": "选择入库通知的媒体库",
        "optional": true
      },
      {
        "method": "GET",
        "path": "/api/plugin-host/emby/items",
        "reason": "分页检测电影及剧集入库",
        "optional": true
      },
      {
        "method": "GET",
        "path": "/api/organize/history",
        "reason": "用户配置映射后检测整理历史",
        "optional": true
      },
      {
        "method": "GET",
        "path": "/api/tasks",
        "reason": "用户配置映射后检测后台任务",
        "optional": true
      },
      {
        "method": "GET",
        "path": "/api/history",
        "reason": "用户配置映射后检测操作历史",
        "optional": true
      },
      {
        "method": "GET",
        "path": "/api/tmdb/movie/:id",
        "reason": "读取入库媒体的公开海报与分类",
        "optional": true
      },
      {
        "method": "GET",
        "path": "/api/tmdb/tv/:id",
        "reason": "读取入库媒体的公开海报与分类",
        "optional": true
      }
    ],
    "network": [
      {
        "origin": "https://qyapi.weixin.qq.com",
        "methods": [
          "GET",
          "POST"
        ],
        "proxy_mode": "direct",
        "reason": "通过宿主管理的应用凭据获取 Token 并发送企业微信应用消息"
      }
    ]
  },
  "ui": {
    "mode": "federation",
    "icon": "frontend/icon.svg",
    "federation": {
      "entry": "frontend/dist/assets/remoteEntry.js",
      "assets_root": "frontend/dist/assets",
      "module": "./AppPage"
    }
  },
  "license": "MIT",
  "tags": [
    "wecom",
    "notification",
    "emby"
  ]
}
